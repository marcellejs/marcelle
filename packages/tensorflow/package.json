{
  "name": "@marcellejs/tensorflow",
  "description": "Marcelle models and components based on Tensorflow.js",
  "version": "0.6.5",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcellejs/marcelle"
  },
  "author": {
    "name": "Jules Françoise",
    "email": "me@julesfrancoise.com"
  },
  "keywords": [
    "marcelle",
    "interactive machine learning"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./marcelle-tensorflow.css": "./dist/marcelle-tensorflow.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
