    "lint": "eslint src",
    "clean": "rimraf dist types"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/postcss": "^4.3.5",
    "@tsconfig/svelte": "^5.0.9",
    "@tsdown/css": "^0.23.7",
    "@types/node": "^26.6.6",
    "daisyui": "^5.8.1",
    "postcss": "^8.5.33",
    "postcss-import": "^17.0.1",
    "postcss-load-config": "^6.0.1",
    "rollup-plugin-svelte": "^7.2.3",
    "svelte": "^5.57.3",
    "svelte-preprocess": "^6.0.5",
    "svelte2tsx": "^0.7.63",
    "tailwindcss": "^4.3.5",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@marcellejs/core": "workspace:^0.6.5",
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow-models/knn-classifier": "^1.2.6",
